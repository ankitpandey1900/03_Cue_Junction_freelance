generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// -----------------------------------------
// User & Auth
// -----------------------------------------
model User {
  id            String    @id @default(uuid())
  email         String    @unique
  name          String?
  emailVerified Boolean   @default(false)
  image         String?
  role          String    @default("STAFF") // "ADMIN" or "STAFF"
  status        String    @default("ACTIVE") // "ACTIVE" or "INACTIVE"
  lastLoginAt   DateTime?
  lastLogoutAt  DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  activityLogs  ActivityLog[]
  accounts      Account[]
  sessions      AuthSession[]
  receivedPayments Payment[]
}

model Account {
  id                    String  @id @default(uuid())
  accountId             String
  providerId            String
  userId                String
  user                  User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model AuthSession {
  id        String   @id @default(uuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("auth_session")
}

// -----------------------------------------
// Customer
// -----------------------------------------
model Customer {
  id            String    @id @default(uuid())
  name          String
  phone         String    @unique
  email         String?
  totalSpend    Float     @default(0)
  loyaltyPoints Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  isArchived    Boolean   @default(false)

  bookings      Booking[]
  sessions      Session[]
  orders        CustomerOrder[]
  invoices      Invoice[]
}

// -----------------------------------------
// Asset Management
// -----------------------------------------
model TableType {
  id            String    @id @default(uuid())
  name          String    
  hourlyRate    Float
  minimumCharge Float     @default(0)
  
  // Advanced pricing options
  fixedRate          Float?
  fixedDuration      Int?      // in minutes
  overtimeHourlyRate Float?    // Rate charged after fixedDuration is exceeded
  
  isArchived         Boolean   @default(false)

  tables             Table[]
  bookings           Booking[]
}

model Table {
  id            String      @id @default(uuid())
  tableTypeId   String
  name          String      
  status        String      @default("AVAILABLE") // "AVAILABLE" | "OCCUPIED" | "RESERVED" | "MAINTENANCE"
  
  isArchived    Boolean     @default(false)

  tableType     TableType   @relation(fields: [tableTypeId], references: [id])
  bookings      Booking[]
  sessions      Session[]

  @@index([status])
}

// -----------------------------------------
// Bookings & Sessions
// -----------------------------------------
model Booking {
  id            String        @id @default(uuid())
  customerId    String
  tableId       String?
  tableTypeId   String?
  startTime     DateTime
  endTime       DateTime
  status        String        @default("PENDING") // "PENDING" | "CONFIRMED" | "CANCELLED" | "COMPLETED"
  createdAt     DateTime      @default(now())
  
  customer      Customer      @relation(fields: [customerId], references: [id])
  table         Table?        @relation(fields: [tableId], references: [id])
  tableType     TableType?    @relation(fields: [tableTypeId], references: [id])
  session       Session?      
}

model Session {
  id                        String        @id @default(uuid())
  customerId                String?
  tableId                   String
  bookingId                 String?       @unique
  invoiceId                 String?
  type                      String        @default("POSTPAID") // "PREPAID" | "POSTPAID"
  startTime                 DateTime      @default(now())
  endTime                   DateTime?
  totalPauseDurationSeconds Int           @default(0)
  extraCharges              Float         @default(0)
  lastPausedAt              DateTime?
  status                    String        @default("ACTIVE") // "ACTIVE" | "PAUSED" | "COMPLETED"
  
  customer                  Customer?     @relation(fields: [customerId], references: [id])
  table                     Table         @relation(fields: [tableId], references: [id])
  booking                   Booking?      @relation(fields: [bookingId], references: [id])
  
  orders                    CustomerOrder[]
  invoice                   Invoice?      @relation(fields: [invoiceId], references: [id])

  @@index([status])
  @@index([invoiceId])
}

// -----------------------------------------
model MenuCategory {
  id           String     @id @default(uuid())
  name         String
  slug         String     @unique
  description  String?
  displayOrder Int        @default(0)
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  menuItems    MenuItem[]
}

model MenuItem {
  id              String              @id @default(uuid())
  categoryId      String
  sku             String              @unique
  name            String
  slug            String              @unique
  description     String?
  basePrice       Float
  imageUrl        String?
  preparationTime Int                 @default(10) // in minutes
  displayOrder    Int                 @default(0)
  isAvailable     Boolean             @default(true)
  isFeatured      Boolean             @default(false)
  stock           Int                 @default(0)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  category        MenuCategory        @relation(fields: [categoryId], references: [id])
  orderItems      CustomerOrderItem[]

  @@index([name])
  @@index([slug])
  @@index([categoryId])
  @@index([isAvailable])
}

model CustomerOrder {
  id         String              @id @default(uuid())
  customerId String?
  sessionId  String?
  invoiceId  String?
  status     String              @default("PENDING") // "PENDING" | "PREPARING" | "READY" | "SERVED" | "CANCELLED"
  subtotal   Float               @default(0)
  discount   Float               @default(0)
  tax        Float               @default(0)
  total      Float               @default(0)
  notes      String?
  createdBy  String?
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  session    Session?            @relation(fields: [sessionId], references: [id])
  customer   Customer?           @relation(fields: [customerId], references: [id])
  invoice    Invoice?            @relation(fields: [invoiceId], references: [id])
  orderItems CustomerOrderItem[]

  @@index([createdAt])
  @@index([status])
  @@index([sessionId])
  @@index([invoiceId])
}

model CustomerOrderItem {
  id                 String        @id @default(uuid())
  orderId            String
  menuItemId         String
  itemNameSnapshot   String
  categorySnapshot   String
  unitPriceSnapshot  Float
  quantity           Int
  totalPrice         Float

  order              CustomerOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem           MenuItem      @relation(fields: [menuItemId], references: [id])
}

// -----------------------------------------
// Billing
// -----------------------------------------
model Invoice {
  id              String        @id @default(uuid())
  invoiceNumber   Int           @unique @default(autoincrement())
  customerId      String?
  sessionTotal    Float         @default(0)
  cafeTotal       Float         @default(0)
  taxAmount       Float         @default(0)
  discountAmount  Float         @default(0)
  grandTotal      Float
  status          String        @default("UNPAID") // "UNPAID" | "PARTIAL" | "PAID" | "REFUNDED" | "CANCELLED"
  paymentMethod   String?       @default("CASH") // "CASH" | "CARD" | "UPI" | "MIXED"
  dueDate         DateTime?
  notes           String?
  createdAt       DateTime      @default(now())
  isArchived      Boolean       @default(false)
  
  customer        Customer?     @relation(fields: [customerId], references: [id])
  sessions        Session[]
  orders          CustomerOrder[]
  payments        Payment[]

  @@index([createdAt])
  @@index([status])
  @@index([isArchived])
  @@index([customerId])
}

model Payment {
  id          String        @id @default(uuid())
  invoiceId   String
  amount      Float
  method      String        // "CASH" | "CARD" | "UPI"
  receivedById String?
  paidAt      DateTime      @default(now())
  
  invoice     Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  receivedBy  User?         @relation(fields: [receivedById], references: [id])

  @@index([paidAt])
  @@index([invoiceId])
  @@index([receivedById])
}

// -----------------------------------------
// Audit Log
// -----------------------------------------
model ActivityLog {
  id          String   @id @default(uuid())
  userId      String
  action      String
  entityType  String
  entityId    String
  metadata    String?  // SQLite does not support Json, fallback to String
  createdAt   DateTime @default(now())
  
  user        User     @relation(fields: [userId], references: [id])

  @@index([createdAt])
  @@index([userId])
  @@index([entityType])
}

// -----------------------------------------
// Settings
// -----------------------------------------
model CafeSettings {
  id                  String    @id @default(uuid())
  cafeName            String    @default("Cue Junction Cafe")
  defaultHourlyRate   Float     @default(200)
  receiptFooterText   String    @default("Thank you for visiting!")
  logoUrl             String?
  address             String?
  phone               String?
  email               String?
  currency            String    @default("INR")
  taxRate             Float     @default(0)
  gstin               String?
  businessHours       String?
  acceptUpi           Boolean   @default(true)
  acceptCard          Boolean   @default(true)
  acceptCash          Boolean   @default(true)
  updatedAt           DateTime  @updatedAt
}
